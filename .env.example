# =====================================================================
# .env -- image versions and a few switches, read automatically by
# "docker compose". Versions are pinned on purpose: the labs were written
# against these, and a newer major version may behave differently.
# =====================================================================
POSTGRES_IMAGE=pgvector/pgvector:pg17
REDIS_IMAGE=redis:8-alpine
MONGO_IMAGE=mongo:8.0
CASSANDRA_IMAGE=cassandra:5.0
NEO4J_IMAGE=neo4j:5.26-community
KAFKA_IMAGE=apache/kafka:4.0.0
PYTHON_IMAGE=python:3.12-slim

# Lab 1, Part D changes this switch to turn Redis persistence (AOF) on or off.
REDIS_APPENDONLY=no
